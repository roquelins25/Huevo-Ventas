function fxRotuloGrfc = ```
		( amount : NUMERIC ) => 
		    IF(
		        amount > 0 ,
		        SWITCH(
		            TRUE(),
		            amount >= 1e6, "€ #,#0,,.00M",
		            amount >= 1e3, "€ #,#0,.00K",
		            "€ #,#0.00" 
		        ),
		        SWITCH(
		            TRUE(),
		            ABS( amount ) >= 1e6, "(€ #,#0,,.00M)",
		            ABS( amount ) >= 1e3, "(€ #,#0,.00K)",
		            "(€ #,#0.00)" )
		        )
		```
	lineageTag: 11b6f7b0-29cb-45d2-ac97-600267f4cee5

