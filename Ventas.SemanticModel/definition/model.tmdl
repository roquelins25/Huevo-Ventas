model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Fatos

	annotation PBI_QueryGroupOrder = 0

queryGroup Dimensões

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DATOS POWER BI","Productos Grupo","Intercos","Rappel","Medias Inprovo","Tamanos_Agrupados","tipo_huevo","Data Hora Atualização","_Medidas","FxSemana","xRLS"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'DATOS POWER BI'
ref table 'Productos Grupo'
ref table Intercos
ref table Rappel
ref table 'Medias Inprovo'
ref table 'CALENDARIO DAX'
ref table Tamanos_Agrupados
ref table tipo_huevo
ref table _Medidas
ref table xParametro
ref table yAcess
ref table xRLS
ref table xEmpresa
ref table 'Data Hora Atualização'

ref cultureInfo pt-BR

