	partition 'CALENDARIO DAX' = calculated
		mode: import
		source =
				
				var minAno = YEAR(MIN('DATOS POWER BI'[Fecha])) //2026
				var MaxAno = YEAR(MAX('DATOS POWER BI'[Fecha])) //2035
				RETURN
				ADDCOLUMNS(
				    FILTER(
				        CALENDARAUTO(),
				        YEAR([Date]) >= minAno &&
				        YEAR([Date]) <= MaxAno),
				        "Ano", YEAR([Date]),
				        "Mês", MONTH([Date]),
				        "Nome do Mês", FORMAT([Date],"mmmm","PT-BR"),
				        "Mês Abrev",UPPER(LEFT(FORMAT([Date], "mmm"), 1)) & LOWER(RIGHT(FORMAT([Date], "mmm"), 2)),
				        "trimestre", CONCATENATE(QUARTER([Date]),"-Trimestre"),
				        "semestre", SWITCH(
				                        TRUE(),
				                        MONTH([Date]) IN{1,2,3,4,5,6}, "1-Sem",
				                        "2-Sem"),
				        "Dia",DAY([Date]),
				        "Dia/Mes", CONCATENATE( CONCATENATE( DAY( [Date] ), "-"), FORMAT([Date],"mmm") ),
				        "DiasSemana",SWITCH(
				            WEEKDAY([Date]),
				            1,"Domingo",
				            2,"Segunda",
				            3,"Terça",
				            4,"Quarta",
				            5,"Quinta",
				            6,"Sexta",
				            7,"Sabado"),
				        "Mes Atual", IF( YEAR( [Date] ) = YEAR( TODAY() ) && MONTH( [Date] ) = MONTH( TODAY() ), "S", "N" ),
				        "Ano-Mes", UPPER(LEFT(FORMAT([Date], "mmm"), 1)) & LOWER(RIGHT(FORMAT([Date], "mmm"), 2)) & "-" & YEAR( [Date] ),
				        "OrderBy", (YEAR( [Date] )*100) + MONTH( [Date] ),
				        "Numerosemana", WEEKNUM( [Date],1)
				    )

	annotation PBI_Id = 16fda023be0e4c72a07fc8eefc9c1909

